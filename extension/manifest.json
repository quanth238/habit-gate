{
  "manifest_version": 3,
  "name": "Habit Gate",
  "version": "1.1.1",
  "description": "Complete your Habitify essentials before opening your selected websites.",
  "minimum_chrome_version": "123",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "alarms",
    "declarativeNetRequest",
    "scripting"
  ],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.fb.com/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Habit Gate",
    "default_popup": "popup.html"
  },
  "incognito": "spanning",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "default_block",
        "enabled": true,
        "path": "default-rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
